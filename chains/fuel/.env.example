# Copy to `.env` and fill in what you need. Both `scripts/deploy.ts` and `scripts/testnet-e2e.ts`
# load this file via `dotenv/config`. Every variable below has a working default EXCEPT the
# funding keys, which have no safe default (see the "Funding" section).

# ── Network ──

# GraphQL endpoint to connect to. Defaults to Fuel Sepolia's public RPC. Point this at a local
# `fuel-core` node (e.g. one launched via `fuels/test-utils`' `launchTestNode`, or a plain
# `fuel-core run` dev node) for fast iteration -- both scripts work identically either way.
# FUEL_PROVIDER_URL=https://testnet.fuel.network/v1/graphql
# FUEL_PROVIDER_URL=http://127.0.0.1:4000/v1/graphql

# ── Deterministic deployment (scripts/deploy.ts, scripts/deploy/salt.ts) ──

# Overrides the deterministic-deploy salt seed. Leave unset to use the documented default
# ('train.protocol.v2.fuel') -- only change this for a deliberate fresh deployment generation
# (mirrors the EVM port's CREATE2 salt bump convention, e.g. train.protocol.v1 -> v2).
# FUEL_DEPLOY_SALT_SEED=train.protocol.v2.fuel

# Deployer's private key for scripts/deploy.ts. Only needs real funds if `train`/`payout_curve`
# are not already deployed at the predicted deterministic address on the target network (a
# fully-idempotent re-run against an already-deployed network needs no funds at all). If unset,
# a fresh wallet is generated and printed each run.
# FUEL_DEPLOY_PRIVATE_KEY=0x...

# Point scripts/testnet-e2e.ts at an EXISTING deployment instead of deploying/reusing via
# scripts/deploy.ts's deployAll. Both must be set together.
# FUEL_TRAIN_CONTRACT_ID=0x...
# FUEL_PAYOUT_CURVE_CONTRACT_ID=0x...

# ── Funding (scripts/testnet-e2e.ts) ──
#
# Fuel's testnet faucet (https://faucet-testnet.fuel.network/) is CAPTCHA-gated (Cloudflare
# bot-challenge + Google reCAPTCHA on the dispense endpoint itself -- confirmed against the live
# endpoint; see scripts/lib/funding.ts's header comment) and cannot be automated from a script.
# You MUST fund exactly ONE wallet by hand -- every other role below is a freshly generated
# wallet, automatically topped up FROM the primary wallet at the start of each run, so you never
# need to push more than one address through the faucet's CAPTCHA.
#
# 1. Generate a wallet (e.g. `node -e "console.log(require('fuels').WalletUnlocked.generate())"`,
#    or just run the script once with this unset -- it prints a freshly generated address).
# 2. Fund it manually via https://faucet-testnet.fuel.network/ (or bridge testnet Sepolia ETH,
#    or use an already-funded wallet you control).
# 3. Set FUEL_E2E_PRIMARY_PRIVATE_KEY to that wallet's private key and re-run.
FUEL_E2E_PRIMARY_PRIVATE_KEY=

# Optional: pin any of these to a stable, already-funded wallet instead of letting the script
# generate + auto-top-up a fresh one each run. Every one of these is OPTIONAL.
# FUEL_E2E_USER_PRIVATE_KEY=0x...
# FUEL_E2E_SPONSOR_PRIVATE_KEY=0x...
# FUEL_E2E_SOLVER_PRIVATE_KEY=0x...
# FUEL_E2E_RELAYER_PRIVATE_KEY=0x...
# FUEL_E2E_THIRD_PARTY_PRIVATE_KEY=0x...
# FUEL_E2E_BENEFICIARY_PRIVATE_KEY=0x...
