# Deployer private key, WITH 0x prefix (scripts read it via vm.envUint)
PRIVATE_KEY=

# Etherscan API v2 key - one key verifies on all Etherscan-family testnets
ETHERSCAN_API_KEY=

# Single-chain RPC override for ad-hoc runs
# (multi-chain deploys use the [rpc_endpoints] aliases in foundry.toml)
RPC_URL=

# Optional: override the CREATE2 salt (bytes32 hex) used by DeployDeterministic.s.sol.
# Default: keccak256('train.protocol.v1'). CHANGING THIS CHANGES ALL ADDRESSES.
# CREATE2_SALT=

# Tron deployer private key (no 0x prefix; tronweb convention)
TRON_PRIVATE_KEY=

# Optional: max TRX burned per Tron contract deployment, in sun (default 1000000000 = 1000 TRX)
# TRON_FEE_LIMIT=
