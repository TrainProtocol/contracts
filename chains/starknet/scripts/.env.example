RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_KEY
# Optional block tag for RPC calls; some providers reject "pending" so default is "latest"
# RPC_BLOCK_TAG=latest

# ── User account ──
# On Sepolia this MUST be a real SNIP-9-capable wallet (Argent, Braavos, or Ready) — Rail B
# (execute_from_outside_v2) is validated against this exact account. PRIVATE_KEY must be the raw
# STARK-curve signing key for that wallet (no guardian / single-owner account), since the e2e
# suite signs Rail A/Rail B payloads directly with `ec.starkCurve.sign`.
ACCOUNT_ADDRESS=0x...
PRIVATE_KEY=0x...

# ── Relayer ──
# Pays gas for the gasless flows (Rail A TrainRouter.forward_intent, Rail B
# execute_from_outside_v2). Defaults to ACCOUNT_ADDRESS/PRIVATE_KEY (self-relay) when unset.
# RELAYER_ADDRESS=0x...
# RELAYER_PRIVATE_KEY=0x...

# ── Solver ──
# Used by the solver-lock flows (F-J). Defaults to RELAYER, then to ACCOUNT_ADDRESS, when unset.
# SOLVER_ADDRESS=0x...
# SOLVER_PRIVATE_KEY=0x...

# ── Tokens ──
# Canonical Sepolia STRK (principal) and ETH (second / reward token). The suite never deploys or
# mints a token — it spends from whatever balance the configured accounts already hold, in tiny
# (wei-scale, ~1000/~100) amounts since the happy paths cycle funds back to the same accounts.
# Override to point at different ERC20s (e.g. on a local devnet where these canonical addresses
# hold no code) via STRK_ADDRESS/ETH_ADDRESS or the shorter TOKEN/TOKEN2 aliases.
# STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
# ETH_ADDRESS=0x049d36570d4e46f48e99674bd3fcc84644ddd6b96f7c741b1562b82f9e004dc7
# TOKEN=0x...
# TOKEN2=0x...

# ── deploy.ts (single-contract legacy flow) ──
CONTRACT_ADDRESS=0x...
CLASS_HASH=0x...
TOKEN_ADDRESS=0x049d36570d4e46f48e99674bd3fcc84644ddd6b96f7c741b1562b82f9e004dc7
# Optional: different reward token for solver-lock-diff-reward demo
# REWARD_TOKEN_ADDRESS=0x...

# ── deploy-all.ts / sepolia-e2e.ts ──
# Optional: reuse already-deployed contracts instead of declaring/deploying fresh ones.
# Leave unset to deploy fresh, deterministic (see DEPLOY_SALT), idempotent instances.
# CONSTANT_CURVE=0x...
# TRAIN=0x...
# TRAIN_ROUTER=0x...

# Optional: salt seed for deterministic UDC deploys in deploy-all.ts (default:
# "train-protocol-e2e-v1"). Change this to force fresh addresses on the same network.
# DEPLOY_SALT=train-protocol-e2e-v1
