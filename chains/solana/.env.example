# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Devnet RPC endpoint used by scripts and the e2e harness.
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# Optional: override the RPC used specifically by scripts/devnet-e2e.ts.
# RPC_URL=https://api.devnet.solana.com

# Funded devnet keypairs, each a JSON byte-array secret key (e.g. the contents of
# a `solana-keygen` file: [12,34,...] — 64 numbers). These map to the E2E actor
# roles (see README "Actor roles"):
#   DEFAULT_KEY     -> relayer / fee-payer / redeemer + mint authority (must be well funded)
#   SOLVER_KEY      -> user  (source-side depositor; holds tokens)
#   THIRDPARTY_KEY  -> solver (destination-side depositor; holds tokens)
DEFAULT_KEY=[0,0,0, ... 64 numbers ...]
SOLVER_KEY=[0,0,0, ... 64 numbers ...]
THIRDPARTY_KEY=[0,0,0, ... 64 numbers ...]

# Optional: path to a keypair file used as the E2E fee payer instead of DEFAULT_KEY.
# FEE_PAYER_KEYPAIR=/absolute/path/to/id.json
